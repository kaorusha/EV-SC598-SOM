# ==============================================================================
# CrossCore Embedded Studio (CCES) / Eclipse CDT Build Outputs
# ==============================================================================
[Dd]ebug/
[Rr]elease/
[Bb]uild/
bin/
obj/

# CCES compiled executables, loader files and object files
*.dxe
*.ldr
*.doj
*.o
*.obj
*.exe
*.d
*.map
*.ipa
*.isb
*.pgo
*.xml.bak
linker_log.xml

# Generated Makefiles and dependency files inside build folders
makefile
objects.mk
sources.mk
subdir.mk
includes-*.txt
input-file.txt

# Eclipse / CCES workspace & temp files
.metadata/
.loadpath
.recommenders/
*.bak
*.tmp
*~

# ==============================================================================
# VS Code
# ==============================================================================
.vscode/*
!.vscode/c_cpp_properties.json
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.vscode/*.log
.vscode/ipch/
.vscode/.history/

# ==============================================================================
# Windows OS temporary files
# ==============================================================================
[Tt]humbs.db
[Dd]esktop.ini
$RECYCLE.BIN/
*.lnk

# ==============================================================================
# macOS temporary files
# ==============================================================================
.DS_Store
.AppleDouble
.LSOverride
._*

# Claude Code personal settings
.claude/settings.local.json

# Raw ADC sample dumps written over JTAG when ENABLE_ADC_CAPTURE = 1 (Audio_Talkthrough_I2S.c),
# used to check ADC bit patterns (e.g. the 192 kHz bit-error diagnosis)
adc_capture*.txt

# Local measurement data: REW sessions (.mdat) and exports, ADC capture dumps (index: measurements/README.md)
measurements/

# Python bytecode caches (tools/*.py)
__pycache__/
